{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "tamasfe.even-better-toml",
                "gleam.gleam",
                "samuelcolvin.jinjahtml",
                "ms-python.python",
                "ms-python.black-formatter",
                "ms-python.isort"
            ]
        }
    },
    "postCreateCommand": "/workspaces/ticketing/scripts/install_zsh.sh -t robbyrussell && echo export UV_LINK_MODE=copy >> ~/.zshrc && cd /workspaces/ticketing/vite && npm install",
    "forwardPorts": [
        5000,
        3000
    ]
}